# ---------------------------------------------------------------------------
# Copy to .env (next to docker-compose.prod.yml) and fill in.
# .env is git-ignored - never commit real values.
# ---------------------------------------------------------------------------

# ---- PostgreSQL ----
POSTGRES_USER=quizhost
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=quizhost

# ---- Backend ----
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production if it is short or a placeholder.
SECRET_KEY=CHANGE_ME_random_48_bytes_min

# Comma separated. Must be your real origin(s) - no "*", no localhost.
CORS_ORIGINS=https://YOUR_REAL_DOMAIN

# The bundled nginx proxies everything, so the browser sees a single origin.
# true is correct behind that proxy. Set false if uvicorn is ever exposed
# directly, otherwise clients can spoof X-Forwarded-For and bypass IP limits.
RATE_LIMIT_TRUST_PROXY=true
RATE_LIMIT_ENABLED=true

# PostgreSQL connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ---- Frontend (build-time) ----
FRONTEND_PORT=8080
# Same-origin: nginx proxies /api -> backend and /ws -> backend.
VITE_API_URL=/api
# Leave empty so the client derives wss:// from the page origin.
VITE_WS_URL=
# frontend/.env is EXCLUDED from the Docker build context, so these must be set
# here or the production bundle ships with no Firebase config (phone auth dead).
# They are Firebase *web client* keys - public by design.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Must stay false in production (reCAPTCHA bypass only works on localhost).
VITE_FIREBASE_SKIP_RECAPTCHA=false

# ---- AI (Groq) ----
# https://console.groq.com/keys
GROQ_API_KEY=
# Verified working model id.
GROQ_MODEL=qwen/qwen3.8-27b

# ---- Google OAuth (optional) ----
# Authorized redirect URI must exactly match this value, and must be https://
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_REAL_DOMAIN/api/auth/google/callback

# ---- Firebase phone auth (optional) ----
# Add your domain to Firebase > Authentication > Authorised domains.
# Keep the literal \n escapes inside the quoted private key.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=