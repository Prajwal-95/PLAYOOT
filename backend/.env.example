# PLAYOOT IN EVERYWHERE - Backend configuration template
#
#   cp .env.example .env
#
# This file MUST contain placeholders only. Never commit a filled-in .env.
#
# ---------------------------------------------------------------------------
# PRODUCTION IS STRICTLY VALIDATED AT START-UP.
# With ENVIRONMENT=production the app REFUSES TO BOOT unless all of the
# following hold, and prints every problem it found:
#   * SECRET_KEY   - unique, >= 32 chars, not a placeholder
#   * DATABASE_URL - PostgreSQL (sqlite is refused)
#   * DEBUG        - false
#   * AUTO_MIGRATE - false (migrations are a separate deploy step)
#   * CORS_ORIGINS - non-empty, no "*", no localhost / 127.0.0.1
#   * GROQ_API_KEY - set whenever AI_ENABLED=true
#   * GOOGLE_REDIRECT_URI - https:// and not localhost (if Google OAuth is on)
# ---------------------------------------------------------------------------

# ------------------------------------------------------------ App
APP_NAME=PLAYOOT IN EVERYWHERE
# development | production | test
ENVIRONMENT=development
DEBUG=true

# ------------------------------------------------------------ Database
# SQLite (local development and tests only)
DATABASE_URL=sqlite+aiosqlite:///./quizhost.db

# PostgreSQL (production) - required when ENVIRONMENT=production
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/quizhost

# Echo SQL queries (dev only)
DB_ECHO=false

# Connection pool - PostgreSQL only, ignored for SQLite
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Run `alembic upgrade head` automatically at startup.
# Handy in development; MUST be false in production, where it is an explicit
# deployment step:
#   docker compose -f docker-compose.prod.yml run --rm backend alembic upgrade head
AUTO_MIGRATE=true

# ------------------------------------------------------------ Auth
# Generate a real one for production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# ------------------------------------------------------------ Game
GAME_PIN_LENGTH=6
MAX_TEAM_SIZE=4
MAX_PLAYERS_PER_GAME=500
NICKNAME_MIN_LENGTH=2
NICKNAME_MAX_LENGTH=20
TEAM_NAME_MIN_LENGTH=2
TEAM_NAME_MAX_LENGTH=24
ANSWER_GRACE_MS=400
DEFAULT_TIME_LIMIT=20
DEFAULT_POINTS=1000

# ------------------------------------------------------------ CORS
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# ------------------------------------------------------------ AI (Groq)
# Get your API key from https://console.groq.com/
GROQ_API_KEY=
# Must be a real model id from https://console.groq.com/docs/models
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=60.0
# Retry transient provider failures (429 / timeout / 5xx) with exponential backoff
GROQ_MAX_ATTEMPTS=3
GROQ_RETRY_BASE_DELAY=1.5
AI_ENABLED=true

# ------------------------------------------------------------ RATE LIMITING
# Master switch (set false to disable every limit)
RATE_LIMIT_ENABLED=true
# MUST be true behind nginx, false when uvicorn is exposed directly
# (otherwise a client can spoof X-Forwarded-For and bypass every IP limit)
RATE_LIMIT_TRUST_PROXY=true

# -- auth, keyed by IP, per RATE_WINDOW seconds --
AUTH_RATE_WINDOW_SECONDS=60
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=5
AUTH_TOKEN_LIMIT=20

# -- AI generation, keyed by user and by IP, per AI window (hourly) --
AI_RATE_WINDOW_SECONDS=3600
AI_GENERATE_USER_LIMIT=30
AI_GENERATE_IP_LIMIT=60
AI_PDF_USER_LIMIT=10
AI_PDF_IP_LIMIT=20

# ------------------------------------------------------------ OAuth (Google)
# Get credentials from https://console.cloud.google.com/
#
# Register the EXACT value of GOOGLE_REDIRECT_URI as an authorized redirect URI
# in the Google Cloud console. It must be https:// and must NOT contain
# localhost when ENVIRONMENT=production (the app refuses to boot otherwise).
#   dev : http://localhost:8000/api/auth/google/callback
#   prod: https://YOUR_DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ------------------------------------------------------------ Firebase (Phone Auth)
# Get credentials from https://console.firebase.google.com/
#
# Production must supply these as ENVIRONMENT VARIABLES. The
# firebase-service-account.json file is a development convenience only: it is
# git-ignored, excluded from the Docker image by .dockerignore, and ignored by
# the app entirely when ENVIRONMENT=production.
#
#   firebase: console > Project settings > Service accounts > Generate new
#   private key. Copy project_id / private_key / client_email here.
#   The private key must keep its literal \n escapes, e.g.
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
#
# Also add your production domain under:
#   Firebase console > Authentication > Settings > Authorised domains
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=