# Playoot in Everywhere - FRONTEND configuration template
#
#   cp .env.example .env
#
# Only variables prefixed with VITE_ reach the browser bundle. Everything here
# is PUBLIC by definition - never put a server secret (SECRET_KEY, GROQ_API_KEY,
# GOOGLE_CLIENT_SECRET, Firebase private key, database password) in this file.
#
# ---------------------------------------------------------------------------
# PRODUCTION VALUES TO REPLACE
#   VITE_API_URL                -> same-origin "/api" (nginx proxies it)
#   VITE_WS_URL                 -> leave EMPTY; the client derives wss:// from
#                                   the page origin, so it works on any domain
#   VITE_FIREBASE_SKIP_RECAPTCHA -> MUST be false in production
# ---------------------------------------------------------------------------

# Base URL of the backend. NOTE: this MUST include the /api prefix, because
# every path in src/services/api.ts is relative (e.g. "/auth/login") and the
# FastAPI router is mounted under /api.
VITE_API_URL=http://localhost:8000/api

# WebSocket base URL. Empty => derived from window.location (ws:// or wss://).
VITE_WS_URL=

# Firebase web app config -- Firebase console > Project settings > Your apps.
# These client keys are designed to be public; access is restricted by
# authorised domains and API-key restrictions, not by hiding them.
# Add your production domain to Firebase > Authentication > Authorised domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Skips the reCAPTCHA challenge on localhost, which Firebase does not accept as
# an authorised domain for phone auth. DEV ONLY -- set to false in production,
# otherwise real users will not be able to receive the SMS code.
VITE_FIREBASE_SKIP_RECAPTCHA=true
